# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=webdata_service

# Firecrawl
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Firecrawl extract job poll timeout (default: 5m, formato: 2m, 5m, 10m)
FIRECRAWL_EXTRACT_TIMEOUT=5m

# Service
PORT=8150

# JWT
# Secreto compartido HS256 con catalog-service: webdata firma acá su JWT de servicio
# `system_admin` (PLAT-E39 T9b/D8) y catalog-service lo verifica con el mismo secreto.
# Sin fallback horneado (D4): el proceso frena si falta.
JWT_SECRET=your-secret-here

# Catalog service (PLAT-E39 T9b)
# Base URL de catalog-service, dueño del catálogo de plataforma. Los adapters de
# product/enrichment hablan con este servicio (antes apuntaban a pim-service con un
# header de rol forjable). Default: http://mc-catalog-service:8160 (lab-network).
CATALOG_SERVICE_URL=http://localhost:8160

# Log level (debug, info, warn, error)
LOG_LEVEL=info
